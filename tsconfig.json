{
  // Type checking is opt-in per file, not repo-wide.
  //
  // "checkJs": false means only files that start with `// @ts-check` are
  // checked. The data layer opts in — that is where this project's bugs have
  // actually lived (a stored flag drifting out of sync with the markup, a null
  // record reaching a function that only guarded undefined). The React
  // components do not: they are the most JSX-heavy and least type-hungry code,
  // and checking them would mean hundreds of implicit-any reports for very
  // little caught.
  //
  // To opt a file in, add `// @ts-check` at the top and annotate with JSDoc.
  // Shared shapes live in src/types.d.ts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"]
}
